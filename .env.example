# Copy to .env before deployment: cp .env.example .env

# Entry address for browser and mobile QR scanning.
# Must be reachable from the phone, for example:
# PUBLIC_WEB_BASE_URL=http://192.168.1.100:8001
PUBLIC_WEB_BASE_URL=http://192.168.1.100:8001

# Change this before production use.
JWT_SECRET=please-change-this-to-a-long-random-string

# Business time used by inspection records and reports.
TZ=Asia/Shanghai
APP_TIMEZONE=Asia/Shanghai

# false = clean startup:
#   creates bootstrap admin + basic rooms/equipment + inspection check item templates.
# true = demo startup:
#   creates demo users, rooms, equipment and historical inspection records.
SEED_DEMO_DATA=false

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=123456
BOOTSTRAP_ADMIN_NAME=管理员
BOOTSTRAP_ADMIN_PHONE=13800000000
