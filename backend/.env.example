APP_NAME=机房智能巡检与问题闭环管理系统
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=sqlite:///./inspection.db

JWT_SECRET=please-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

TZ=Asia/Shanghai
APP_TIMEZONE=Asia/Shanghai

UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=/uploads

# 巡检二维码扫出来指向的前端地址（本地开发前端默认跑在 8001）。
# 手机要扫码：改成电脑局域网 IP，例如 http://192.168.1.100:8001
# 仅本机浏览器测试：用 http://localhost:8001 即可
PUBLIC_WEB_BASE_URL=http://192.168.1.100:8001
FRONTEND_ROUTER_MODE=hash

CORS_ORIGINS=["http://localhost:8001","http://192.168.1.100:8001"]

# false = clean startup: admin + basic rooms/equipment + inspection check item templates.
SEED_DEMO_DATA=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=123456
BOOTSTRAP_ADMIN_NAME=管理员
BOOTSTRAP_ADMIN_PHONE=13800000000
