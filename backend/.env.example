APP_NAME=机房智能巡检与问题闭环管理系统
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=sqlite:///./inspection.db

JWT_SECRET=please-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=/uploads

# 巡检二维码扫出来指向的前端地址（本地开发前端默认跑在 8001）。
# 手机要扫码：改成电脑局域网 IP，例如 http://172.16.5.219:8001
# 仅本机浏览器测试：用 http://localhost:8001 即可
PUBLIC_WEB_BASE_URL=http://172.16.5.219:8001
FRONTEND_ROUTER_MODE=hash

CORS_ORIGINS=["http://localhost:8001","http://172.16.5.219:8001"]
